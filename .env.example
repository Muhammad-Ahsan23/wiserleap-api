APP_NAME="WiserLeap API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------- WiserLeap API ----------
# Next.js site(s) allowed to call this API (comma-separated, exact origins)
FRONTEND_URLS=http://localhost:3000
# Where password reset links point (the Next.js site)
FRONTEND_URL=http://localhost:3000
# Domains that get cookie (session) auth - the Next.js host(s), no scheme
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Production example:
# FRONTEND_URLS=https://wiserleap.com,https://www.wiserleap.com
# FRONTEND_URL=https://wiserleap.com
# SANCTUM_STATEFUL_DOMAINS=wiserleap.com,www.wiserleap.com
# SESSION_DOMAIN=.wiserleap.com
# SESSION_SECURE_COOKIE=true

# First account can always sign up; after that sign-up is closed unless true
ADMIN_REGISTRATION_ENABLED=false

# Uploaded images: "public" (storage/app/public) or an S3-compatible disk
MEDIA_DISK=public
BLOG_IMAGE_MAX_KB=2048
AUTHOR_IMAGE_MAX_KB=800
PUBLIC_CACHE_MINUTES=10

# Set when behind a proxy/CDN so rate limits use the real visitor IP
# TRUSTED_PROXIES=*
